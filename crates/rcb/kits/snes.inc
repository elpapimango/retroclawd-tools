; Super Nintendo hardware kit: addresses and values for rcb projects.
INIDISP     = $2100          ; bit 7 forced blank, bits 0-3 brightness
OBSEL       = $2101
OAMADDL     = $2102
OAMDATA     = $2104
BGMODE      = $2105
BG1SC       = $2107
BG12NBA     = $210B
BG1HOFS     = $210D
BG1VOFS     = $210E
VMAINC      = $2115          ; bit 7: increment after the high byte
VMADDL      = $2116
VMDATAL     = $2118
VMDATAH     = $2119
CGADD       = $2121
CGDATA      = $2122          ; write low then high (15-bit BGR)
TM          = $212C          ; main screen layers
APUIO0      = $2140
APUIO1      = $2141
APUIO2      = $2142
APUIO3      = $2143
NMITIMEN    = $4200          ; bit 7 NMI, 0 auto joypad read
MDMAEN      = $420B
HDMAEN      = $420C
RDNMI       = $4210          ; bit 7: NMI flag (reading clears it)
HVBJOY      = $4212          ; bit 7 vblank, 0 auto-read busy
JOY1L       = $4218          ; 16 bits: see the JOY_ masks
DMAP0       = $4300          ; DMA channel 0 (+ $10 per channel)
BBAD0       = $4301
A1T0L       = $4302
A1B0        = $4304
DAS0L       = $4305
JOY_B       = $8000
JOY_Y       = $4000
JOY_SELECT  = $2000
JOY_START   = $1000
JOY_UP      = $0800
JOY_DOWN    = $0400
JOY_LEFT    = $0200
JOY_RIGHT   = $0100
JOY_A       = $0080
JOY_X       = $0040
JOY_L       = $0020
JOY_R       = $0010
